# Copy this file to terraform.tfvars and fill in actual values.
# terraform.tfvars is gitignored — never commit real values.

aws_region    = "us-east-1"
domain_name   = "arclight-complex.net"
environment   = "staging"

# RDS
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20

# ECS service counts (fixed capacity for v1)
core_desired_count         = 1
shuttleforge_desired_count = 1
podbay_desired_count       = 1

# Podbay EC2 capacity (0 until workspace tasks are needed)
podbay_ec2_instance_type      = "t3.medium"
podbay_ec2_desired_capacity   = 0

# Image tags
core_image_tag              = "v1-abc1234"
podbay_workspace_image_tag  = "v1-initial"

# Alerts
alarm_email = "ops@example.com"

# GitHub OIDC
github_org   = "arclight-intel"
github_repos = [
  "arclight-core",
  "arclight-shuttleforge",
  "arclight-podbay",
  "arclight-overcast",
]

# Bandersnatch (bandersnatch.tf). Real values live only in terraform.tfvars, never in git.
bandersnatch_enabled         = false
bandersnatch_desired_count   = 0
bandersnatch_image           = "" # repository@sha256:<digest> once the first image is pushed
bandersnatch_mail_mode       = "graph"
bandersnatch_public_host     = "page.example.com"
bandersnatch_graph_tenant_id = "00000000-0000-0000-0000-000000000000"
bandersnatch_graph_client_id = "00000000-0000-0000-0000-000000000000"
bandersnatch_mail_from       = "no-reply@example.com"
bandersnatch_mail_from_name  = "Example"
bandersnatch_mail_reply_to   = "replies@example.com"
bandersnatch_mail_subject    = "Your link"
bandersnatch_page_title      = "Example"
