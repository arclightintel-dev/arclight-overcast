[Unit]
Description=Backstage Portal bridge firewall (proxy endpoints only)
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/backstage-firewall
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
